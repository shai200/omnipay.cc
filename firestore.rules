rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: authenticated users can read and write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Onramp events are written by the Admin SDK. Clients may read only their own.
    // Collection queries must filter userId to the signed-in user.
    match /onramp_events/{eventId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Onramp sessions are written by the Admin SDK. Clients may read only their own.
    // Collection queries must filter userId to the signed-in user.
    match /onramp_sessions/{sessionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
  }
}
