rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: authenticated users can read and write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Onramp events: only server can write (via Admin SDK)
    match /onramp_events/{eventId} {
      allow read: if request.auth != null;
      allow write: if false; // Only admin SDK can write
    }
    
    // Onramp sessions: only server can write (via Admin SDK)
    match /onramp_sessions/{sessionId} {
      allow read: if request.auth != null;
      allow write: if false; // Only admin SDK can write
    }
  }
}
