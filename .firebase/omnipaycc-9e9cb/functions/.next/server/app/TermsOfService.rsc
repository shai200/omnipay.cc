6:["$","p",null,{"children":"OmniPay.cc uses Stripe's Crypto Onramp to process cryptocurrency purchases. When you complete a transaction, you are also entering into an agreement directly with Stripe, Inc. and subject to its Terms of Service and Crypto Onramp Terms."}]
7:["$","p",null,{"children":"Stripe handles all payment processing, verification, and compliance requirements (including Know Your Customer \"KYC\" and Anti-Money Laundering \"AML\" checks). OmniPay.cc does not store, process, or control your payment credentials or personal verification data."}]
8:["$","h3",null,{"className":"text-xl font-semibold mt-6 mb-3","children":"Compliance with Stripe's Crypto Onramp Terms"}]
9:["$","p",null,{"children":"OmniPay.cc uses Stripe's regulated Crypto Onramp to process payments. By purchasing cryptocurrency through OmniPay.cc, you also agree to comply with the Stripe Crypto Onramp Merchant Terms of Service and Stripe Restricted Businesses Policy."}]
a:["$","p",null,{"children":"OmniPay.cc does not permit use of its services in or by individuals or entities located in any jurisdiction prohibited by Stripe or applicable U.S. law, including Cuba, Iran, North Korea, Syria, and the Crimea, Donetsk, and Luhansk regions of Ukraine."}]
b:["$","h2",null,{"className":"text-2xl font-bold mt-8 mb-4","children":"3. Nature of the Service"}]
c:["$","p",null,{"children":"OmniPay.cc provides access to a user-friendly platform for purchasing cryptocurrency via Stripe's Crypto Onramp. We do not:"}]
d:["$","ul",null,{"className":"list-disc pl-6 space-y-2","children":[["$","li",null,{"children":"Operate as a bank, exchange, broker-dealer, money transmitter, or custodian."}],["$","li",null,{"children":"Hold or store your cryptocurrency or fiat funds."}],["$","li",null,{"children":"Provide financial, investment, or tax advice."}]]}]
e:["$","p",null,{"children":"You are solely responsible for understanding the risks associated with cryptocurrency transactions and should consult a qualified professional before making any financial decisions."}]
f:["$","h2",null,{"className":"text-2xl font-bold mt-8 mb-4","children":"4. Account and Identity Verification"}]
10:["$","p",null,{"children":"To comply with regulatory requirements, you may be asked to provide identification or verification information before completing a transaction. All verification is handled directly by Stripe. OmniPay.cc does not receive or retain your identity documents or payment account information."}]
11:["$","h2",null,{"className":"text-2xl font-bold mt-8 mb-4","children":"5. Fees and Pricing"}]
12:["$","p",null,{"children":"Transaction fees are determined and displayed by Stripe during checkout. OmniPay.cc may receive a commission or service fee from Stripe for facilitating purchases. Prices and fees are subject to change without notice."}]
13:["$","h2",null,{"className":"text-2xl font-bold mt-8 mb-4","children":"6. Refunds and Chargebacks"}]
14:["$","p",null,{"children":"Cryptocurrency transactions are final and irreversible once completed on the blockchain. By using OmniPay.cc, you acknowledge and agree that:"}]
15:["$","ul",null,{"className":"list-disc pl-6 space-y-2","children":[["$","li",null,{"children":"You cannot reverse, refund, or cancel completed transactions."}],["$","li",null,{"children":"Stripe's standard refund or chargeback protections for card payments do not apply once cryptocurrency is delivered."}],["$","li",null,{"children":"OmniPay.cc has no ability to recover funds once transmitted on-chain."}]]}]
16:["$","h2",null,{"className":"text-2xl font-bold mt-8 mb-4","children":"7. Risks and Disclaimers"}]
17:["$","p",null,{"children":"By using OmniPay.cc, you understand and accept the following:"}]
18:["$","ul",null,{"className":"list-disc pl-6 space-y-2","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Volatility:"}]," Cryptocurrency prices can fluctuate dramatically, and you may lose value."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Regulatory Risk:"}]," Crypto laws may change and impact your rights or access."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Security Risk:"}]," Blockchain transactions are irreversible; if your wallet or private keys are compromised, funds may be permanently lost."]}],["$","li",null,{"children":[["$","strong",null,{"children":"No Guarantees:"}]," OmniPay.cc makes no representations or warranties about future value, performance, or suitability of any cryptocurrency."]}]]}]
