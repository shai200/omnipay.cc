# Copy to .env.local for local development. Never commit real values.
# .env.local is gitignored. Firebase App Hosting reads the same names from
# apphosting.yaml, where each one is a Cloud Secret Manager secret.

# Browser-public Stripe publishable key (pk_test_... or pk_live_...).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Browser-public Firebase web app config, as a JSON string.
# {"apiKey":"...","appId":"...","authDomain":"...","projectId":"...","messagingSenderId":"...","storageBucket":"..."}
NEXT_PUBLIC_FIREBASE_CONFIG=

# Server-only. Used by POST /api/onramp-session. Prefer a restricted key.
STRIPE_SECRET_KEY=

# Server-only. Firebase service account JSON, as a single-line string.
FIREBASE_SERVICE_ACCOUNT=

# Optional when the service account JSON already includes project_id.
FIREBASE_PROJECT_ID=

# Cloud Functions runtime only. Do not commit a real key.
# SENDGRID_API_KEY=
