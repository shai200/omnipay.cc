# Copy to .env.local for local development. Never commit real values.
# .env.local is gitignored. Railway service variables use the same names.
# NEXT_PUBLIC_* values are inlined into the browser bundle at image build time,
# so they must be present for the Docker build, not only at runtime.

# Public origin of this app, including https:// and no trailing path.
# Used for auth cookies, Google's redirect, and links in email.
# Local example: http://localhost:3000
BETTER_AUTH_URL=

# Server-only. Signs session cookies. At least 32 random characters.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth client. Create this in Google Cloud, not from the Firebase web config.
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
# Leave both empty to hide working Google sign-in until they are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Browser-public Stripe publishable key (pk_test_... or pk_live_...).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server-only. Used by POST /api/onramp-session. Prefer a restricted key.
STRIPE_SECRET_KEY=

# Server-only. Signing secret (whsec_...) for POST /api/stripe/webhook.
# This is not a Stripe API key. Create it in the Stripe Dashboard webhook settings.
STRIPE_WEBHOOK_SECRET=

# Server-only. Railway Postgres connection string.
# Railway injects this from the Postgres service. Do not commit it.
DATABASE_URL=

# Server-only. SendGrid mail key for the email cron and password reset.
# The jobs send nothing when this is empty.
SENDGRID_API_KEY=

# Optional. Defaults to support@omnipay.cc. The address must be a verified SendGrid sender.
SENDGRID_FROM_EMAIL=

# Optional SendGrid dynamic template overrides. The defaults are the templates
# already used by the previous Cloud Functions.
# SENDGRID_TEMPLATE_WELCOME=
# SENDGRID_TEMPLATE_FIRST_PURCHASE=
# SENDGRID_TEMPLATE_ABANDONED_CART=
# SENDGRID_TEMPLATE_REMINDER=

# Server-only. Firebase Auth password-hash parameters from the Firebase console
# (Authentication → Users → Password hash parameters). Required once, so existing
# email/password users can sign in and have their hash upgraded to bcrypt.
# Remove them after every password user has signed in once, or rely on password reset.
# FIREBASE_SCRYPT_SIGNER_KEY=
# FIREBASE_SCRYPT_SALT_SEPARATOR=
# FIREBASE_SCRYPT_ROUNDS=
# FIREBASE_SCRYPT_MEM_COST=

# One-off migration only. Not used by the web server or the email cron.
# Set to yes only on the machine that runs scripts/migrate-firebase.ts.
# ALLOW_DATA_MIGRATION=
# FIREBASE_SERVICE_ACCOUNT=
# FIREBASE_PROJECT_ID=

# Email cron only. When true, the job counts work and does not send or mark mail sent.
# EMAIL_JOBS_DRY_RUN=
